# 环境变量示例
#
# 使用方式：
#   1. 复制为 .env（已被 .gitignore 忽略）或在部署环境注入同名环境变量；
#   2. Windows PowerShell：$env:DB_PASSWORD="xxx" 后在同窗口启动应用；
#   3. Linux / systemd / Docker：使用 Environment= 或 -e 注入。
#
# application.yaml 中的默认值只服务于本机开发，生产环境必须显式覆盖。

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=study_tour
DB_USERNAME=root
DB_PASSWORD=change-me

# Flyway 数据库版本管理；生产环境保持开启，排查问题时可临时设为 false
FLYWAY_ENABLED=true

# ---------- Redis / Redis Stack ----------
# 向量检索（RediSearch）需要 Redis Stack；普通缓存用 Redis 即可
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 认证 ----------
# HS256 密钥，至少 64 字符；生产环境不要使用仓库中的默认值
JWT_SECRET=please-generate-a-random-secret-at-least-64-characters-long

# ---------- HTTPS ----------
# src/main/resources/ssl/study-tour.p12 的密钥库口令
SSL_KEY_STORE_PASSWORD=change-me

# ---------- 模型服务 ----------
# 对话模型（默认指向 DeepSeek OpenAI 兼容接口）
CHAT_MODEL_KEY=
# 可选项：none / low / medium / high，用于关闭或降低推理消耗
CHAT_REASONING_EFFORT=none
# 向量模型（默认 DashScope 兼容接口，输出维度需与 application.yaml 的 1536 对齐）
EMBEDDING_MODEL_KEY=
# 语义边生成（可选）
SEMANTIC_EDGE_API_KEY=

# ---------- 高德开放平台 ----------
AMAP_KEY=

# ---------- 阿里云 OSS ----------
# 上传头像/图片使用的 bucket
OSS_BUCKET=study-tour-image
# 访问凭证不写在配置里：SDK 从标准环境变量读取
#   ALIBABA_CLOUD_ACCESS_KEY_ID
#   ALIBABA_CLOUD_ACCESS_KEY_SECRET

# ---------- 接口文档 ----------
# 是否暴露 /v3/api-docs 与 /swagger-ui.html；生产环境可关闭
OPENAPI_ENABLED=true
